{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-reminder.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-agents-before-bridge.sh",
            "timeout": 5,
            "statusMessage": "Checking agents ran before bridge..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-branch.sh",
            "timeout": 3,
            "statusMessage": "Checking branch safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-status-authority-sync.sh",
            "timeout": 15,
            "statusMessage": "Checking STATUS.md authority sync..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "verifier|adversary|expert|structural-proof|grounding|fuzzer|translator|visualizer|advisor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-agent-compliance.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
