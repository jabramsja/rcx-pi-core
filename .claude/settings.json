{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-reminder.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "verifier|adversary|expert|structural-proof|grounding|fuzzer|translator|visualizer|advisor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-agent-compliance.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
