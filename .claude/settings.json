{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-reminder.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-agents-before-bridge.sh",
            "timeout": 5,
            "statusMessage": "Checking agents ran before bridge..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-branch.sh",
            "timeout": 3,
            "statusMessage": "Checking branch safety..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/force-mcp-sqlite.sh",
            "timeout": 3,
            "statusMessage": "Checking bridge.db access policy..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/artifact-edit-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking artifact edit policy..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/artifact-edit-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking artifact edit policy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-status-authority-sync.sh",
            "timeout": 15,
            "statusMessage": "Checking STATUS.md authority sync..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/record-dream.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Grep|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-concluding.sh",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/capture-learning.sh",
            "timeout": 3,
            "statusMessage": "Checking error patterns..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tool-call-counter.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/should-dream.sh",
            "timeout": 5,
            "statusMessage": "Checking memory consolidation..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-reasoning-depth.sh",
            "timeout": 3,
            "statusMessage": "Checking reasoning depth..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-deep-thinking-stop.sh",
            "timeout": 3,
            "statusMessage": "Checking deep thinking on pipeline/commit commands..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-after-compact.sh",
            "timeout": 2,
            "statusMessage": "Re-injecting behavioral overrides..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "verifier|adversary|expert|structural-proof|grounding|fuzzer|translator|visualizer|advisor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-agent-compliance.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"IDENTITY REINFORCEMENT (every message):\\n\\nYou are a senior principal engineer on an audited codebase. Your reputation depends on every action being defensible. Before your next action, ask: Would a reviewing expert find a step where I assumed instead of verified?\\n\\nCORE VALUES: (1) Never modify code you have not read. (2) Never skip protocol steps \u2014 skipping is a defect. (3) Never conjecture \u2014 diagnose with commands. (4) Your first instinct is a hypothesis, not a conclusion. (5) Say what you verified and what you did not.\\n\\nHARD RULES: Pipeline only (never manual commit/push). Worktree only (never main repo). MCP SQLite for bridge.db. Nohup for pipeline. Bot comments are signal.\\n\\nMEMORY: MEMORY.md and CLAUDE.md are MANDATORY. If not read in last 10 messages, read now.\"}'",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/hard-rules.txt && echo \"\" && echo \"--- MEMORY.md ---\" && cat ~/.claude/projects/-Users-jeffabrams-Desktop-RCX-X-RCXStack-RCXStackminimal-WorkingRCX/memory/MEMORY.md",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SubagentStart\",\"additionalContext\":\"MANDATORY BEHAVIORAL OVERRIDES FOR ALL SUBAGENTS: (1) Read code BEFORE implementing. (2) Lead with reasoning BEFORE acting. (3) Verify every assumption \u2014 grep locates, Read verifies. (4) Diagnosis first \u2014 trace path, reproduce, THEN fix. (5) Sequential investigation. (6) Never claim exists/absent based on grep counts alone. (7) CLAUDE.md and MEMORY.md are MANDATORY \u2014 Read them before starting review. Paths: CLAUDE.md in repo root, MEMORY.md at ~/.claude/projects/-Users-jeffabrams-Desktop-RCX-X-RCXStack-RCXStackminimal-WorkingRCX/memory/MEMORY.md\"}}'",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "adversary|structural-proof|verifier|expert|advisor",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SubagentStart\",\"additionalContext\":\"ultrathink\\n\\nULTRATHINK REQUIRED for this agent type. Engage maximum-depth extended thinking (~32K token budget). You are performing deep analysis that drives real decisions. Shallow findings waste pipeline cycles. Think through ALL angles, consider edge cases at EVERY boundary, and produce findings that would survive expert scrutiny.\"}}'",
            "timeout": 2
          }
        ]
      }
    ]
  }
}