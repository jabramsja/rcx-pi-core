{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-reminder.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-agents-before-bridge.sh",
            "timeout": 5,
            "statusMessage": "Checking agents ran before bridge..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-branch.sh",
            "timeout": 3,
            "statusMessage": "Checking branch safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-status-authority-sync.sh",
            "timeout": 15,
            "statusMessage": "Checking STATUS.md authority sync..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/record-dream.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Grep|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-concluding.sh",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tool-call-counter.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/should-dream.sh",
            "timeout": 5,
            "statusMessage": "Checking memory consolidation..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-reasoning-depth.sh",
            "timeout": 3,
            "statusMessage": "Checking reasoning depth..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-after-compact.sh",
            "timeout": 2,
            "statusMessage": "Re-injecting behavioral overrides..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "verifier|adversary|expert|structural-proof|grounding|fuzzer|translator|visualizer|advisor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-agent-compliance.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
