# =========================
# RCX generated swarm artifacts (do not commit)
# =========================
archive/docs/latex/build/
*.bbl
*.blg

# RCX hydration manifest (generated)
.rcx_manifest.json

# RCX tooling sandboxes
sandbox_runs/

# Working scratch directory (session artifacts, plans, bridge output)
.scratch/

# Agent review reports (local output, not tracked docs)
# Use wildcard so we can un-ignore subdirectories
reports/*
# Tracked control-plane packets ARE tracked
!reports/control_plane/
!reports/control_plane/**
# But deferred findings ARE tracked (policy decisions)
!reports/deferred/
# L4 wave indicator artifacts ARE tracked (evidence)
!reports/l4_wave_indicators/

# Generated sandbox/smoke artifacts (must not be tracked)
mu/mu_programs/__sandbox_run_*.mu
mu/mu_programs/__smoke_*.mu
mu/mu_programs/sandbox/*
!mu/mu_programs/sandbox/.gitkeep
archive/rcx_pi_rust/mu_programs/__sandbox_run_*.mu
archive/rcx_pi_rust/mu_programs/__smoke_*.mu
scripts/.rcx_manifest.json


# --- Backup/temp artifacts (must never be committed) ---
*.bak
*.bak.*
**/*.bak.*
*.orig
*.rej
*.swp
*.swo
*~
.bak_rcx_fixes_*/
.quarantine_untracked_*
--world
--orbit-seed
cd
ls
echo
rg
sed
set
