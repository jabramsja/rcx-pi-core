{
  "meta": {
    "version": "1.2.0",
    "name": "EXHAUSTION_SEED",
    "description": "Structural operator exhaustion detection for Rule 3.1",
    "doc": "docs/core/OperatorExhaustion.v0.md",
    "spec_ref": "RCXEngineNew.pdf Rule 3.1",
    "execution_layer": "HYBRID",
    "meta_circular_capable": true,
    "requires_patterns": ["non-linear"],
    "requires_bridge": "bootstrap_structural.v1",
    "production_execution": "BOOTSTRAP",
    "production_reason": "Structural normalization converts dict to linked-list, breaking algorithm state format",
    "meta_circular_proven": "Gate 6 (2026-02-02): bootstrap_structural.v1 bridge verified to fire",
    "invariants": [
      "All projections are pure Mu (JSON-compatible)",
      "Exhaustion detection uses pattern matching, NOT Python conditionals",
      "Frozen set is a Mu linked-list, NOT Python set",
      "Non-linear patterns (same var twice) detect operator equality",
      "First-match-wins ordering handles inequality cases"
    ],
    "meta_circular_enabled": "2026-02-02 (Gate 6: Bootstrap-Structural Bridge)",
    "kernel_requirements": [
      "kernel.v1.json (7 projections) for iteration",
      "match.v2.json (8 projections) for pattern matching",
      "bootstrap_structural.v1.json (5 projections) for non-linear pattern support",
      "subst.v2.json (12 projections) for substitution"
    ]
  },
  "projections": [
    {
      "id": "exhaustion.init_null",
      "description": "No tau_step (null) means no closure detected, so no exhaustion possible",
      "pattern": {
        "_detect_exhaustion": {
          "trace": {"var": "trace"},
          "frozen": {"var": "frozen"},
          "tau_step": null,
          "operator_ids": {"var": "op_ids"}
        }
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "continue"
      }
    },
    {
      "id": "exhaustion.init",
      "description": "tau_step is set, begin finding the tau entry in trace",
      "pattern": {
        "_detect_exhaustion": {
          "trace": {"var": "trace"},
          "frozen": {"var": "frozen"},
          "tau_step": {"var": "tau_step"},
          "operator_ids": {"var": "op_ids"}
        }
      },
      "body": {
        "_mode": "exhaustion",
        "_phase": "find_tau",
        "_trace": {"var": "trace"},
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": null,
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaustion.find_match",
      "description": "Found entry where step == tau_step (non-linear pattern), extract operator",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "find_tau",
        "_trace": {
          "head": {
            "step": {"var": "step"},
            "state": {"var": "_state"},
            "projection": {"var": "proj"}
          },
          "tail": {"var": "rest"}
        },
        "_tau_step": {"var": "step"},
        "_tau_operator": {"var": "_"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaustion",
        "_phase": "scan",
        "_trace": {"var": "rest"},
        "_tau_step": {"var": "step"},
        "_tau_operator": {"var": "proj"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaustion.find_continue",
      "description": "Not at tau_step yet, advance to next trace entry",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "find_tau",
        "_trace": {
          "head": {"var": "_head"},
          "tail": {"var": "rest"}
        },
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaustion",
        "_phase": "find_tau",
        "_trace": {"var": "rest"},
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaustion.find_not_found",
      "description": "Reached end of trace without finding tau_step (edge case)",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "find_tau",
        "_trace": null,
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "_"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "continue"
      }
    },
    {
      "id": "exhaustion.scan_same",
      "description": "Current entry has same operator as tau (non-linear), continue scanning",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "scan",
        "_trace": {
          "head": {
            "step": {"var": "_step"},
            "state": {"var": "_state"},
            "projection": {"var": "proj"}
          },
          "tail": {"var": "rest"}
        },
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "proj"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaustion",
        "_phase": "scan",
        "_trace": {"var": "rest"},
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "proj"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaustion.scan_different",
      "description": "Different operator found (scan_same didn't match), not exhausted",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "scan",
        "_trace": {
          "head": {"var": "_head"},
          "tail": {"var": "_rest"}
        },
        "_tau_step": {"var": "_tau_step"},
        "_tau_operator": {"var": "_tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "_op_ids"}
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "continue"
      }
    },
    {
      "id": "exhaustion.scan_end",
      "description": "End of trace reached, same operator throughout -> check if frozen",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "scan",
        "_trace": null,
        "_tau_step": {"var": "_tau_step"},
        "_tau_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaustion",
        "_phase": "check_frozen",
        "_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaustion.frozen_found",
      "description": "Operator already in frozen list (non-linear match), skip",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {
          "head": {"var": "op"},
          "tail": {"var": "_"}
        },
        "_operator_ids": {"var": "_op_ids"}
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "already_frozen"
      }
    },
    {
      "id": "exhaustion.frozen_check_tail",
      "description": "Operator not in head of frozen list, check tail",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {
          "head": {"var": "_other"},
          "tail": {"var": "rest"}
        },
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaustion",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {"var": "rest"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaustion.do_freeze",
      "description": "Operator not in frozen list (null), freeze it",
      "pattern": {
        "_mode": "exhaustion",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": null,
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "exhaustion_detected": true,
        "operator_to_freeze": {"var": "op"},
        "frozen": {
          "head": {"var": "op"},
          "tail": {"var": "frozen"}
        },
        "action": "freeze"
      }
    }
  ]
}
