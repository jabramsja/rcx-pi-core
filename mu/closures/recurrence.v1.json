{
  "meta": {
    "version": "1.2.0",
    "name": "RECURRENCE_SEED",
    "description": "Structural closure detection for Rule 2.2 (Closure-on-Second-Demand)",
    "doc": "docs/core/EngineNewsStructural.v0.md",
    "spec_ref": "RCXEngineNew.pdf Rule 2.2♢, A.10",
    "execution_layer": "HYBRID",
    "meta_circular_capable": true,
    "requires_patterns": ["non-linear"],
    "requires_bridge": "bootstrap_structural.v1",
    "production_execution": "BOOTSTRAP",
    "production_reason": "Structural normalization converts dict to linked-list, breaking algorithm state format",
    "meta_circular_proven": "Gate 6 (2026-02-02): bootstrap_structural.v1 bridge verified to fire",
    "invariants": [
      "All projections are pure Mu (JSON-compatible)",
      "Closure detection uses pattern matching, NOT Python conditionals",
      "Seen-set is a Mu linked-list, NOT Python set",
      "Trace token τ recurrence detected structurally",
      "Non-linear patterns (same var twice) enforced by bootstrap_structural binding conflict detection"
    ],
    "meta_circular_enabled": "2026-02-02 (Gate 6: Bootstrap-Structural Bridge)",
    "kernel_requirements": [
      "kernel.v1.json (7 projections) for iteration",
      "match.v2.json (8 projections) for pattern matching",
      "bootstrap_structural.v1.json (5 projections) for non-linear pattern support",
      "subst.v2.json (12 projections) for substitution"
    ]
  },
  "projections": [
    {
      "id": "recurrence.init",
      "description": "Initialize closure detection state from trace result",
      "pattern": {
        "_detect_closure": {
          "trace": {"var": "trace"},
          "result": {"var": "result"}
        }
      },
      "body": {
        "_mode": "recurrence",
        "_phase": "scan",
        "_current": {"var": "trace"},
        "_seen": null,
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.end_of_trace",
      "description": "Reached end of trace (null) without finding closure",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "scan",
        "_current": null,
        "_seen": {"var": "seen"},
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence_done",
        "_closure": false,
        "_tau_step": null,
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.check_state_stall",
      "description": "Extract state from stall entry (has extra 'stall' key)",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "scan",
        "_current": {
          "head": {
            "step": {"var": "step"},
            "state": {"var": "state"},
            "projection": {"var": "proj"},
            "stall": {"var": "_stall"}
          },
          "tail": {"var": "rest"}
        },
        "_seen": {"var": "seen"},
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": {"var": "seen"},
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.check_state_maxsteps",
      "description": "Extract state from max_steps entry (has extra 'max_steps' key)",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "scan",
        "_current": {
          "head": {
            "step": {"var": "step"},
            "state": {"var": "state"},
            "projection": {"var": "proj"},
            "max_steps": {"var": "_maxsteps"}
          },
          "tail": {"var": "rest"}
        },
        "_seen": {"var": "seen"},
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": {"var": "seen"},
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.check_state",
      "description": "Extract state from current trace entry and check against seen-set",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "scan",
        "_current": {
          "head": {
            "step": {"var": "step"},
            "state": {"var": "state"},
            "projection": {"var": "proj"}
          },
          "tail": {"var": "rest"}
        },
        "_seen": {"var": "seen"},
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": {"var": "seen"},
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.found_in_seen",
      "description": "State found in seen-set (head matches) -> closure detected!",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": {
          "head": {"var": "state"},
          "tail": {"var": "_"}
        },
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence_done",
        "_closure": true,
        "_tau_step": {"var": "step"},
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.not_in_head",
      "description": "State not in seen-set head, continue checking tail",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": {
          "head": {"var": "other"},
          "tail": {"var": "check_rest"}
        },
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": {"var": "check_rest"},
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.not_found",
      "description": "Exhausted check_list (null) without match -> add state to seen, advance",
      "pattern": {
        "_mode": "recurrence",
        "_phase": "check_seen",
        "_state": {"var": "state"},
        "_step": {"var": "step"},
        "_rest": {"var": "rest"},
        "_seen": {"var": "seen"},
        "_check_list": null,
        "_result": {"var": "result"}
      },
      "body": {
        "_mode": "recurrence",
        "_phase": "scan",
        "_current": {"var": "rest"},
        "_seen": {
          "head": {"var": "state"},
          "tail": {"var": "seen"}
        },
        "_result": {"var": "result"}
      }
    },
    {
      "id": "recurrence.unwrap",
      "description": "Extract final closure detection result with tau_step for exhaustion",
      "pattern": {
        "_mode": "recurrence_done",
        "_closure": {"var": "closure"},
        "_tau_step": {"var": "tau"},
        "_result": {"var": "result"}
      },
      "body": {
        "closure_detected": {"var": "closure"},
        "tau_step": {"var": "tau"},
        "final_result": {"var": "result"}
      }
    }
  ]
}
