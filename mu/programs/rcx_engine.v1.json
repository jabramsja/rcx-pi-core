{
  "meta": {
    "version": "1.3.0",
    "name": "RCX_ENGINE",
    "description": "Main RCX engine combining fix, recurrence, and exhaustion detection with structural iteration (TRANSITIONAL trampoline, Boot1 sunset policy applies)",
    "doc": "mu/docs/core/RCXEngine.v0.md",
    "spec_ref": "RCXEngineNew.pdf Rule 0.6, Rule 2.2♢, Rule 3.1",
    "status": "structural_specification",
    "execution_layer": "APPLICATION",
    "requires_patterns": ["non-linear"],
    "dependencies": [
      "fix.v1.json (structural fix routine, Rule 0.6)",
      "recurrence.v2.json (hash-accelerated closure detection)",
      "exhaustion.v1.json (operator exhaustion)"
    ],
    "invariants": [
      "All projections are pure Mu (JSON-compatible)",
      "Engine orchestrates fix, recurrence, and exhaustion detection",
      "Input: _run_engine with projections, input, and config",
      "Output: result with closure_detected, exhaustion_detected, frozen set",
      "Boundary operations use _boundary_request (algebraic effect protocol)",
      "Host services _boundary_request generically: operation, input, context, inject_key",
      "Any host (Python, JS, Rust) can drive the engine from one generic dispatch loop",
      "Stall triggers Fix dispatch (Rule 0.6) before recurrence detection",
      "Structural iteration: action=freeze triggers trampoline re-entry via _run_engine (TRANSITIONAL, Boot1 sunset policy applies)",
      "_config carries projections and max_steps through all phases for re-entry envelope (Boot1-compatible ABI)"
    ]
  },
  "projections": [
    {
      "id": "engine.init",
      "description": "Initialize engine run with default config — request trace generation",
      "pattern": {
        "_run_engine": {
          "projections": {"var": "projs"},
          "input": {"var": "input"}
        }
      },
      "body": {
        "_boundary_request": {
          "operation": "run_trace",
          "input": {
            "projections": {"var": "projs"},
            "value": {"var": "input"},
            "max_steps": 100
          },
          "context": {
            "_mode": "engine",
            "_frozen": null,
            "_config": {
              "projections": {"var": "projs"},
              "max_steps": 100
            }
          },
          "inject_key": "_trace_result"
        }
      }
    },
    {
      "id": "engine.init_config",
      "description": "Initialize engine run with custom config — request trace generation",
      "pattern": {
        "_run_engine": {
          "projections": {"var": "projs"},
          "input": {"var": "input"},
          "max_steps": {"var": "max"},
          "frozen": {"var": "frozen"}
        }
      },
      "body": {
        "_boundary_request": {
          "operation": "run_trace",
          "input": {
            "projections": {"var": "projs"},
            "value": {"var": "input"},
            "max_steps": {"var": "max"}
          },
          "context": {
            "_mode": "engine",
            "_frozen": {"var": "frozen"},
            "_config": {
              "projections": {"var": "projs"},
              "max_steps": {"var": "max"}
            }
          },
          "inject_key": "_trace_result"
        }
      }
    },
    {
      "id": "engine.trace_done",
      "description": "Trace complete — request boundary hash (mu_hash is a host primitive)",
      "pattern": {
        "_mode": "engine",
        "_frozen": {"var": "frozen"},
        "_config": {"var": "config"},
        "_trace_result": {
          "result": {"var": "result"},
          "trace": {"var": "trace"},
          "stall": {"var": "stall"}
        }
      },
      "body": {
        "_boundary_request": {
          "operation": "hash_trace",
          "input": {"var": "trace"},
          "context": {
            "_mode": "engine",
            "_result": {"var": "result"},
            "_frozen": {"var": "frozen"},
            "_stall": {"var": "stall"},
            "_raw_trace": {"var": "trace"},
            "_config": {"var": "config"}
          },
          "inject_key": "_hashed_trace"
        }
      }
    },
    {
      "id": "engine.hash_done_fix",
      "description": "Stall detected after hash — dispatch Fix routine (Rule 0.6) before recurrence",
      "pattern": {
        "_mode": "engine",
        "_result": {"var": "result"},
        "_frozen": {"var": "frozen"},
        "_stall": true,
        "_raw_trace": {"var": "raw_trace"},
        "_config": {"var": "config"},
        "_hashed_trace": {"var": "hashed_trace"}
      },
      "body": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "fix.v1.json",
          "input": {
            "apply_fix": {
              "stalled_state": {"var": "result"},
              "stall_hash": "structural_stall",
              "tau_step": 1,
              "engine_iteration": 0
            }
          },
          "context": {
            "_mode": "engine",
            "_result": {"var": "result"},
            "_frozen": {"var": "frozen"},
            "_stall": true,
            "_raw_trace": {"var": "raw_trace"},
            "_config": {"var": "config"},
            "_hashed_trace": {"var": "hashed_trace"}
          },
          "inject_key": "_fix_result"
        }
      }
    },
    {
      "id": "engine.hash_done",
      "description": "Trace hashed (non-stall) — request recurrence detection (run_algorithm effect)",
      "pattern": {
        "_mode": "engine",
        "_result": {"var": "result"},
        "_frozen": {"var": "frozen"},
        "_stall": {"var": "stall"},
        "_raw_trace": {"var": "raw_trace"},
        "_config": {"var": "config"},
        "_hashed_trace": {"var": "hashed_trace"}
      },
      "body": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "recurrence.v2.json",
          "input": {
            "_detect_closure": {
              "trace": {"var": "hashed_trace"},
              "result": {"var": "result"}
            }
          },
          "context": {
            "_mode": "engine",
            "_frozen": {"var": "frozen"},
            "_stall": {"var": "stall"},
            "_raw_trace": {"var": "raw_trace"},
            "_config": {"var": "config"}
          },
          "inject_key": "_recurrence_result"
        }
      }
    },
    {
      "id": "engine.fix_done_applied",
      "description": "Fix applied — forward fixed_state to recurrence, stall broken",
      "pattern": {
        "_mode": "engine",
        "_result": {"var": "original"},
        "_frozen": {"var": "frozen"},
        "_stall": true,
        "_raw_trace": {"var": "raw_trace"},
        "_config": {"var": "config"},
        "_hashed_trace": {"var": "hashed_trace"},
        "_fix_result": {
          "fixed_state": {"var": "fixed"},
          "fix_applied": true,
          "fix_type": {"var": "fix_type"}
        }
      },
      "body": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "recurrence.v2.json",
          "input": {
            "_detect_closure": {
              "trace": {"var": "hashed_trace"},
              "result": {"var": "fixed"}
            }
          },
          "context": {
            "_mode": "engine",
            "_frozen": {"var": "frozen"},
            "_stall": false,
            "_raw_trace": {"var": "raw_trace"},
            "_config": {"var": "config"}
          },
          "inject_key": "_recurrence_result"
        }
      }
    },
    {
      "id": "engine.fix_done_none",
      "description": "Fix not applicable — forward original result to recurrence, stall persists",
      "pattern": {
        "_mode": "engine",
        "_result": {"var": "original"},
        "_frozen": {"var": "frozen"},
        "_stall": true,
        "_raw_trace": {"var": "raw_trace"},
        "_config": {"var": "config"},
        "_hashed_trace": {"var": "hashed_trace"},
        "_fix_result": {
          "fixed_state": {"var": "fixed"},
          "fix_applied": false,
          "fix_type": {"var": "fix_type"}
        }
      },
      "body": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "recurrence.v2.json",
          "input": {
            "_detect_closure": {
              "trace": {"var": "hashed_trace"},
              "result": {"var": "original"}
            }
          },
          "context": {
            "_mode": "engine",
            "_frozen": {"var": "frozen"},
            "_stall": true,
            "_raw_trace": {"var": "raw_trace"},
            "_config": {"var": "config"}
          },
          "inject_key": "_recurrence_result"
        }
      }
    },
    {
      "id": "engine.recurrence_done",
      "description": "Recurrence complete — request exhaustion detection (run_algorithm effect)",
      "pattern": {
        "_mode": "engine",
        "_frozen": {"var": "frozen"},
        "_stall": {"var": "stall"},
        "_raw_trace": {"var": "raw_trace"},
        "_config": {"var": "config"},
        "_recurrence_result": {
          "closure_detected": {"var": "closure"},
          "tau_step": {"var": "tau"},
          "final_result": {"var": "result"}
        }
      },
      "body": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "exhaustion.v1.json",
          "input": {
            "_detect_exhaustion": {
              "trace": {"var": "raw_trace"},
              "frozen": {"var": "frozen"},
              "tau_step": {"var": "tau"},
              "operator_ids": null
            }
          },
          "context": {
            "_mode": "engine",
            "_stall": {"var": "stall"},
            "_closure_detected": {"var": "closure"},
            "_tau_step": {"var": "tau"},
            "_final_result": {"var": "result"},
            "_config": {"var": "config"}
          },
          "inject_key": "_exhaustion_result"
        }
      }
    },
    {
      "id": "engine.exhaustion_done_freeze",
      "description": "Exhaustion detected with action=freeze — trampoline re-entry (TRANSITIONAL, Boot1 sunset policy)",
      "pattern": {
        "_mode": "engine",
        "_stall": {"var": "stall"},
        "_closure_detected": {"var": "closure"},
        "_tau_step": {"var": "tau"},
        "_final_result": {"var": "result"},
        "_config": {
          "projections": {"var": "projs"},
          "max_steps": {"var": "max"}
        },
        "_exhaustion_result": {
          "exhaustion_detected": {"var": "exhausted"},
          "operator_to_freeze": {"var": "op"},
          "frozen": {"var": "new_frozen"},
          "action": "freeze"
        }
      },
      "body": {
        "_run_engine": {
          "projections": {"var": "projs"},
          "input": {"var": "result"},
          "max_steps": {"var": "max"},
          "frozen": {"var": "new_frozen"}
        }
      }
    },
    {
      "id": "engine.exhaustion_done_terminal",
      "description": "Exhaustion complete (non-freeze) — produce final engine result",
      "pattern": {
        "_mode": "engine",
        "_stall": {"var": "stall"},
        "_closure_detected": {"var": "closure"},
        "_tau_step": {"var": "tau"},
        "_final_result": {"var": "result"},
        "_config": {"var": "config"},
        "_exhaustion_result": {
          "exhaustion_detected": {"var": "exhausted"},
          "operator_to_freeze": {"var": "op"},
          "frozen": {"var": "new_frozen"},
          "action": {"var": "action"}
        }
      },
      "body": {
        "engine_result": {
          "value": {"var": "result"},
          "closure_detected": {"var": "closure"},
          "tau_step": {"var": "tau"},
          "exhaustion_detected": {"var": "exhausted"},
          "operator_frozen": {"var": "op"},
          "frozen_set": {"var": "new_frozen"},
          "action": {"var": "action"},
          "stall": {"var": "stall"}
        }
      }
    },
    {
      "id": "engine.unwrap",
      "description": "Extract final engine result",
      "pattern": {
        "engine_result": {"var": "result"}
      },
      "body": {"var": "result"}
    }
  ]
}
