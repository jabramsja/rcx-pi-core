{
  "meta": {
    "version": "1.0.0",
    "name": "RCX_ENGINE",
    "description": "Main RCX engine combining recurrence and exhaustion detection",
    "doc": "docs/core/RCXEngine.v0.md",
    "spec_ref": "RCXEngineNew.pdf Rule 2.2♢, Rule 3.1",
    "status": "design_only",
    "execution_layer": "APPLICATION",
    "requires_patterns": ["non-linear"],
    "dependencies": [
      "recurrence.v1.json (closure detection)",
      "exhaustion.v1.json (operator exhaustion)"
    ],
    "invariants": [
      "All projections are pure Mu (JSON-compatible)",
      "Engine orchestrates recurrence and exhaustion detection",
      "Input: _run_engine with projections, input, and config",
      "Output: result with closure_detected, exhaustion_detected, frozen set"
    ]
  },
  "projections": [
    {
      "id": "engine.init",
      "description": "Initialize engine run with default config",
      "pattern": {
        "_run_engine": {
          "projections": {"var": "projs"},
          "input": {"var": "input"}
        }
      },
      "body": {
        "_mode": "engine",
        "_phase": "run_trace",
        "_projections": {"var": "projs"},
        "_input": {"var": "input"},
        "_max_steps": 100,
        "_frozen": null,
        "_trace_result": null,
        "_recurrence_result": null,
        "_exhaustion_result": null
      }
    },
    {
      "id": "engine.init_config",
      "description": "Initialize engine run with custom config",
      "pattern": {
        "_run_engine": {
          "projections": {"var": "projs"},
          "input": {"var": "input"},
          "max_steps": {"var": "max"},
          "frozen": {"var": "frozen"}
        }
      },
      "body": {
        "_mode": "engine",
        "_phase": "run_trace",
        "_projections": {"var": "projs"},
        "_input": {"var": "input"},
        "_max_steps": {"var": "max"},
        "_frozen": {"var": "frozen"},
        "_trace_result": null,
        "_recurrence_result": null,
        "_exhaustion_result": null
      }
    },
    {
      "id": "engine.trace_done",
      "description": "Trace complete, start recurrence detection",
      "pattern": {
        "_mode": "engine",
        "_phase": "run_trace",
        "_projections": {"var": "projs"},
        "_input": {"var": "input"},
        "_max_steps": {"var": "max"},
        "_frozen": {"var": "frozen"},
        "_trace_result": {
          "result": {"var": "result"},
          "trace": {"var": "trace"},
          "stall": {"var": "stall"}
        },
        "_recurrence_result": null,
        "_exhaustion_result": null
      },
      "body": {
        "_detect_closure": {
          "trace": {"var": "trace"},
          "result": {"var": "result"}
        },
        "_engine_context": {
          "frozen": {"var": "frozen"},
          "trace": {"var": "trace"},
          "stall": {"var": "stall"}
        }
      }
    },
    {
      "id": "engine.recurrence_done",
      "description": "Recurrence detection complete, start exhaustion if closure found",
      "pattern": {
        "closure_detected": {"var": "closure"},
        "tau_step": {"var": "tau"},
        "final_result": {"var": "result"},
        "_engine_context": {
          "frozen": {"var": "frozen"},
          "trace": {"var": "trace"},
          "stall": {"var": "stall"}
        }
      },
      "body": {
        "_detect_exhaustion": {
          "trace": {"var": "trace"},
          "frozen": {"var": "frozen"},
          "tau_step": {"var": "tau"},
          "operator_ids": null
        },
        "_engine_recurrence": {
          "closure_detected": {"var": "closure"},
          "tau_step": {"var": "tau"},
          "result": {"var": "result"},
          "stall": {"var": "stall"}
        }
      }
    },
    {
      "id": "engine.exhaustion_done",
      "description": "Exhaustion detection complete, produce final result",
      "pattern": {
        "exhaustion_detected": {"var": "exhausted"},
        "operator_to_freeze": {"var": "op"},
        "frozen": {"var": "new_frozen"},
        "action": {"var": "action"},
        "_engine_recurrence": {
          "closure_detected": {"var": "closure"},
          "tau_step": {"var": "tau"},
          "result": {"var": "result"},
          "stall": {"var": "stall"}
        }
      },
      "body": {
        "engine_result": {
          "value": {"var": "result"},
          "closure_detected": {"var": "closure"},
          "tau_step": {"var": "tau"},
          "exhaustion_detected": {"var": "exhausted"},
          "operator_frozen": {"var": "op"},
          "frozen_set": {"var": "new_frozen"},
          "action": {"var": "action"},
          "stall": {"var": "stall"}
        }
      }
    },
    {
      "id": "engine.unwrap",
      "description": "Extract final engine result",
      "pattern": {
        "engine_result": {"var": "result"}
      },
      "body": {"var": "result"}
    }
  ]
}
