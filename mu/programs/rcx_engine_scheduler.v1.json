{
  "meta": {
    "version": "1.0.0",
    "name": "RCX_ENGINE_SCHEDULER",
    "description": "Structural scheduler/operator-pool seed for EngineNew operator selection",
    "doc": "reports/control_plane/post_redteam_engine_state_scheduler_reduction_2026-04-30_2026-04-30.md",
    "spec_ref": "RCXEngineNew.pdf scheduler model: seedOps, Godel-coded unary maps, finite pool, strict lexicographic order, identity-map safeguard, promotion/freeze lifecycle",
    "status": "structural_specification",
    "execution_layer": "META_CIRCULAR",
    "requires_patterns": [
      "non-linear"
    ],
    "ordering_policy": "strict_lexicographic_by_godel_code",
    "invariants": [
      "The scheduler seed decides control data only; it does not execute operators",
      "seedOps is a finite linked-list operator pool for a single scheduler step",
      "Operators use explicit Godel-coded unary-map identity data",
      "The first slice recognizes bounded strict lexicographic witnesses without host sorting",
      "Identity maps are rejected before operator selection",
      "Frozen operators are skipped structurally by matching the frozen linked list",
      "Promotion and freeze lifecycle hooks are returned as Mu data"
    ]
  },
