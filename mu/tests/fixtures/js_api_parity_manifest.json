{
  "version": "1.0.0",
  "description": "Parity manifest for JS API actions. Drives parametrized tests.",
  "error_codes": {
    "api.unknown_action": "Action not recognized",
    "api.bad_request": "Malformed request or missing required fields",
    "input.invalid_type": "Wrong type (e.g., non-dict where dict required)",
    "input.shape_mismatch": "Dict has wrong key set",
    "input.reserved_field": "Contains kernel-reserved or disallowed underscore field",
    "input.malformed_normalized": "Value fails Mu normalization",
    "trace.cycle_detected": "Linked-list trace has a cycle",
    "trace.overcap": "Trace exceeds max_entries cap",
    "engine.exhausted": "Engine reached max iterations without terminal",
    "engine.stalled_non_terminal": "Engine stalled on non-terminal state"
  },
  "actions": {
    "run_vector": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"input": {"a": 1}, "projection": {"id": "test", "pattern": {"a": {"var": "x"}}, "body": {"result": {"var": "x"}}}},
      "optional_args": {},
      "edge_args": [
        {
          "description": "Missing projection (undefined) rejected at stepKernel boundary",
          "args": {"input": {"a": 1}},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "Reserved field in input rejected at domain boundary",
          "args": {"input": {"_mode": "evil"}, "projection": {"pattern": {"x": "X"}, "body": {"x": "X"}}},
          "expected_error_code": "input.reserved_field"
        }
      ]
    },
    "run_all_vectors": {
      "type": "operation",
      "requires_error_edges": false,
      "success_only_reason": "Batch iteration of built-in parity vectors; always succeeds",
      "required_args": {},
      "optional_args": {},
      "edge_args": []
    },
    "run_recurrence": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"projections": [], "input": {"test": true}, "maxSteps": 10},
      "optional_args": {"maxSteps": 100},
      "edge_args": [
        {
          "description": "maxSteps=0 produces empty trace, recurrence on empty is benign",
          "args": {"projections": [], "input": {"test": true}, "maxSteps": 0},
          "expected_success": true
        },
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": 10001},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": "abc"},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "run_exhaustion": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"input": {"test": true}, "maxSteps": 10},
      "optional_args": {"maxSteps": 200},
      "edge_args": [
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"input": {"test": true}, "maxSteps": 10001},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"input": {"test": true}, "maxSteps": "abc"},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "get_constants": {
      "type": "operation",
      "requires_error_edges": false,
      "success_only_reason": "Pure read of constants; no input to reject",
      "required_args": {},
      "optional_args": {},
      "edge_args": []
    },
    "normalize_roundtrip": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"value": {"a": 1, "b": 2}},
      "optional_args": {},
      "edge_args": [
        {
          "description": "Missing value key (JS undefined) rejected by normalize",
          "args": {},
          "expected_error_code": "input.malformed_normalized"
        }
      ]
    },
    "validate_mu": {
      "type": "operation",
      "requires_error_edges": false,
      "success_only_reason": "Always returns success with is_valid boolean; never throws",
      "required_args": {"value": {"a": 1}},
      "optional_args": {},
      "edge_args": []
    },
    "run_recurrence_with_bridge": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"input": {"test": true}, "maxSteps": 10},
      "optional_args": {"maxSteps": 100},
      "edge_args": [
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"input": {"test": true}, "maxSteps": 10001},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"input": {"test": true}, "maxSteps": "abc"},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "run_exhaustion_with_bridge": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"input": {"test": true}, "maxSteps": 10},
      "optional_args": {"maxSteps": 100},
      "edge_args": [
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"input": {"test": true}, "maxSteps": 10001},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"input": {"test": true}, "maxSteps": "abc"},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "validate_reserved_fields": {
      "type": "validation",
      "requires_error_edges": true,
      "required_args": {"value": {"clean": "data"}},
      "optional_args": {},
      "edge_args": [
        {
          "description": "Value with kernel-reserved _mode field",
          "args": {"value": {"_mode": "forged"}},
          "expected_error_code": "input.reserved_field"
        }
      ]
    },
    "validate_algorithm_runtime_fields": {
      "type": "validation",
      "requires_error_edges": true,
      "required_args": {"value": {"_detect_closure": true, "_seen": null}},
      "optional_args": {},
      "edge_args": [
        {
          "description": "Value with non-allowed underscore field",
          "args": {"value": {"_bogus_field": true}},
          "expected_error_code": "input.reserved_field"
        }
      ]
    },
    "run_structural_trace": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"projections": [], "input": {"test": true}, "maxSteps": 10},
      "optional_args": {"maxSteps": 100},
      "edge_args": [
        {
          "description": "Reserved field in input rejected at domain boundary",
          "args": {"input": {"_mode": "evil"}},
          "expected_error_code": "input.reserved_field"
        },
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": 10001},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": "abc"},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "run_hemisphere": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"input": {"route_hemisphere": {"engine_result": {"value": null, "closure_detected": false, "exhaustion_detected": false, "stall": false}, "hemispheres": {"r_null": null, "r_inf": null, "r_a": null, "lobes": null, "sink": null}}}, "maxSteps": 30},
      "optional_args": {"maxSteps": 100},
      "edge_args": [
        {
          "description": "Reserved field in input rejected at domain boundary",
          "args": {"input": {"_mode": "evil"}},
          "expected_error_code": "input.reserved_field"
        },
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"input": {"route_hemisphere": {"engine_result": {"value": null}, "hemispheres": {"r_null": null, "r_inf": null, "r_a": null, "lobes": null, "sink": null}}}, "maxSteps": 10001},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"input": {"route_hemisphere": {"engine_result": {"value": null}, "hemispheres": {"r_null": null, "r_inf": null, "r_a": null, "lobes": null, "sink": null}}}, "maxSteps": "abc"},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "run_engine_pipeline": {
      "type": "operation",
      "requires_error_edges": true,
      "happy_path_may_error": true,
      "required_args": {"projections": [], "input": {"test": true}, "maxSteps": 6, "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
      "optional_args": {"frozen": null, "maxEngineIterations": 20, "maxAlgorithmIterations": 50},
      "edge_args": [
        {
          "description": "Empty projections + simple input exhausts engine iterations",
          "args": {"projections": [], "input": {"test": true}, "maxSteps": 1, "maxEngineIterations": 2, "maxAlgorithmIterations": 2},
          "expected_error_code": "engine.exhausted"
        },
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": 10001, "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": "abc", "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "hash_trace": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"trace": {"head": {"state": "a", "step": {"_num": null}}, "tail": null}},
      "optional_args": {"maxEntries": 10000},
      "edge_args": [
        {
          "description": "Trace exceeding maxEntries cap",
          "args": {"trace": {"head": {"state": "a", "step": {"_num": null}}, "tail": {"head": {"state": "b", "step": {"_num": {"xH": null}}}, "tail": null}}, "maxEntries": 1},
          "expected_error_code": "trace.overcap"
        }
      ]
    },
    "run_hemisphere_routing": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"engine_result": {"value": null, "closure_detected": false, "tau_step": null, "exhaustion_detected": false, "operator_frozen": false, "frozen_set": null, "action": "continue", "stall": false}, "hemispheres": {"r_null": null, "r_inf": null, "r_a": null, "lobes": null, "sink": null}},
      "optional_args": {},
      "edge_args": [
        {
          "description": "Non-dict engine_result",
          "args": {"engine_result": "not_a_dict"},
          "expected_error_code": "input.invalid_type"
        }
      ]
    },
    "run_engine_with_routing": {
      "type": "operation",
      "requires_error_edges": true,
      "happy_path_may_error": true,
      "required_args": {"projections": [], "input": {"test": true}, "maxSteps": 6, "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
      "optional_args": {"hemispheres": null, "frozen": null, "boot1LoopMode": false},
      "edge_args": [
        {
          "description": "Bad hemispheres shape",
          "args": {"projections": [], "input": {"test": true}, "hemispheres": {"bad": "shape"}, "maxSteps": 1},
          "expected_error_code": "input.shape_mismatch"
        },
        {
          "description": "boot1LoopMode non-boolean rejected with type_error",
          "args": {"projections": [], "input": {"test": true}, "boot1LoopMode": "yes", "maxSteps": 6, "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
          "expected_error_code": "type_error"
        },
        {
          "description": "maxSteps exceeds API_MAX_STEPS cap",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": 10001, "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
          "expected_error_code": "api.bad_request"
        },
        {
          "description": "maxSteps non-integer rejected at API boundary",
          "js_api_only": true,
          "args": {"projections": [], "input": {"test": true}, "maxSteps": "abc", "maxEngineIterations": 5, "maxAlgorithmIterations": 10},
          "expected_error_code": "api.bad_request"
        }
      ]
    },
    "run_metabolization_cycle": {
      "type": "operation",
      "requires_error_edges": true,
      "required_args": {"hemispheres": {"r_null": null, "r_inf": null, "r_a": null, "lobes": null, "sink": null}},
      "optional_args": {},
      "edge_args": [
        {
          "description": "Non-dict hemispheres",
          "args": {"hemispheres": "not_a_dict"},
          "expected_error_code": "input.invalid_type"
        },
        {
          "description": "Bad hemispheres shape",
          "args": {"hemispheres": {"bad": "shape"}},
          "expected_error_code": "input.shape_mismatch"
        },
        {
          "description": "Malformed entry in bucket (non-dict)",
          "args": {"hemispheres": {"r_null": [1], "r_inf": null, "r_a": null, "lobes": null, "sink": null}},
          "expected_error_code": "input.shape_mismatch"
        }
      ]
    },
    "step_metabolization": {
      "type": "operation",
      "requires_error_edges": false,
      "success_only_reason": "Runs step() on metabolization projections; inputs are structurally validated by step()",
      "required_args": {"input": {"metabolize_mode": "scan_sink", "sink_entry": {"state": "test", "closure_flag": false, "origin": "test"}, "remaining_sink": null, "hemispheres": {"r_null": null, "r_inf": null, "r_a": null, "lobes": null, "sink": null}}},
      "optional_args": {},
      "edge_args": []
    },
    "step_kernel_meta": {
      "type": "operation",
      "requires_error_edges": false,
      "success_only_reason": "Runs stepKernel with returnMeta=true; inputs validated by stepKernel domain projection checks",
      "required_args": {"input": "a", "projections": [{"id": "test.rewrite", "pattern": "a", "body": "b"}]},
      "optional_args": {"maxSteps": 100, "kernelMode": "core"},
      "edge_args": []
    },
    "run_engine_pipeline_meta": {
      "type": "operation",
      "requires_error_edges": false,
      "success_only_reason": "Runs engine pipeline with meta envelope; inputs validated by engine pipeline checks",
      "required_args": {"input": "test", "projections": []},
      "optional_args": {"maxSteps": 100, "maxEngineIterations": 20, "maxAlgorithmIterations": 50, "boot1LoopMode": true},
      "edge_args": []
    },
    "list_actions": {
      "type": "introspection",
      "requires_error_edges": false,
      "success_only_reason": "Introspection endpoint; no inputs to reject",
      "required_args": {},
      "optional_args": {},
      "edge_args": []
    }
  }
}
