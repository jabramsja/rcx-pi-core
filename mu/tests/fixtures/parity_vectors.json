{
  "description": "Cross-substrate parity test vectors. Same inputs run on both Python and JavaScript, expecting identical outputs.",
  "version": "1.0",
  "vectors": [
    {
      "id": "simple_match",
      "description": "Simple pattern match with variable binding",
      "projection": {
        "pattern": {"op": "double", "value": {"var": "n"}},
        "body": {"result": {"var": "n"}, "doubled": {"var": "n"}}
      },
      "input": {"op": "double", "value": {"_num": {"xH": null}}},
      "expected_output": {"result": {"_num": {"xH": null}}, "doubled": {"_num": {"xH": null}}},
      "expected_stall": true
    },
    {
      "id": "no_match_stall",
      "description": "No projection matches - returns original input",
      "projection": {
        "pattern": {"op": "triple", "value": {"var": "n"}},
        "body": {"result": {"var": "n"}}
      },
      "input": {"op": "double", "value": {"_num": {"xH": null}}},
      "expected_output": {"op": "double", "value": {"_num": {"xH": null}}},
      "expected_stall": true
    },
    {
      "id": "nested_binding",
      "description": "Deep nested pattern with multiple bindings",
      "projection": {
        "pattern": {"outer": {"inner": {"var": "x"}, "also": {"var": "y"}}},
        "body": {"flattened": [{"var": "x"}, {"var": "y"}]}
      },
      "input": {"outer": {"inner": "hello", "also": "world"}},
      "expected_output": {"flattened": ["hello", "world"]},
      "expected_stall": true
    },
    {
      "id": "empty_list_preservation",
      "description": "Empty list in input/output",
      "projection": {
        "pattern": {"items": {"var": "list"}},
        "body": {"original": {"var": "list"}}
      },
      "input": {"items": []},
      "expected_output": {"original": []},
      "expected_stall": true
    },
    {
      "id": "empty_dict_preservation",
      "description": "Empty dict in input/output",
      "projection": {
        "pattern": {"config": {"var": "cfg"}},
        "body": {"saved": {"var": "cfg"}}
      },
      "input": {"config": {}},
      "expected_output": {"saved": {}},
      "expected_stall": true
    },
    {
      "id": "boolean_values",
      "description": "Boolean values in pattern and body",
      "projection": {
        "pattern": {"enabled": true, "data": {"var": "d"}},
        "body": {"processed": {"var": "d"}, "was_enabled": true}
      },
      "input": {"enabled": true, "data": "payload"},
      "expected_output": {"processed": "payload", "was_enabled": true},
      "expected_stall": true
    },
    {
      "id": "null_values",
      "description": "Null values in pattern and body",
      "projection": {
        "pattern": {"value": null},
        "body": {"was_null": true}
      },
      "input": {"value": null},
      "expected_output": {"was_null": true},
      "expected_stall": true
    },
    {
      "id": "numeric_types",
      "description": "StructuralNumbers numeral values",
      "projection": {
        "pattern": {"int_val": {"var": "i"}, "float_val": {"var": "f"}},
        "body": {"int": {"var": "i"}, "float": {"var": "f"}}
      },
      "input": {"int_val": {"_num": {"xH": null}}, "float_val": {"_num": {"xO": {"xH": null}}}},
      "expected_output": {"int": {"_num": {"xH": null}}, "float": {"_num": {"xO": {"xH": null}}}},
      "expected_stall": true
    },
    {
      "id": "catchall_pattern",
      "description": "Variable-only pattern catches everything",
      "projection": {
        "pattern": {"var": "anything"},
        "body": {"wrapped": {"var": "anything"}}
      },
      "input": {"complex": [{"_num": {"xH": null}}, {"_num": {"xO": {"xH": null}}}, {"nested": true}]},
      "expected_output": {"wrapped": {"complex": [{"_num": {"xH": null}}, {"_num": {"xO": {"xH": null}}}, {"nested": true}]}},
      "expected_stall": true
    },
    {
      "id": "repeated_variable",
      "description": "Non-linear pattern (same var twice) — core kernel rejects fail-closed. Both substrates must reject on direct core path. Bridge path (apply_mu/runAlgorithmWithBridge) handles these correctly.",
      "projection": {
        "pattern": {"a": {"var": "x"}, "b": {"var": "x"}},
        "body": {"matched": {"var": "x"}}
      },
      "input": {"a": "same", "b": "same"},
      "expected_error": "non-linear pattern",
      "expected_error_code": "input.nonlinear_pattern"
    },
    {
      "id": "list_with_mixed_types",
      "description": "List containing various types",
      "projection": {
        "pattern": {"items": {"var": "list"}},
        "body": {"saved": {"var": "list"}}
      },
      "input": {"items": [{"_num": {"xH": null}}, "two", true, null, {"key": "value"}]},
      "expected_output": {"saved": [{"_num": {"xH": null}}, "two", true, null, {"key": "value"}]},
      "expected_stall": true
    },
    {
      "id": "unicode_strings",
      "description": "Unicode characters in strings",
      "projection": {
        "pattern": {"text": {"var": "t"}},
        "body": {"echo": {"var": "t"}}
      },
      "input": {"text": "Hello 世界 🌍"},
      "expected_output": {"echo": "Hello 世界 🌍"},
      "expected_stall": true
    },
    {
      "id": "negative_numbers",
      "description": "Structural numeral pair",
      "projection": {
        "pattern": {"x": {"var": "a"}, "y": {"var": "b"}},
        "body": {"values": [{"var": "a"}, {"var": "b"}]}
      },
      "input": {"x": {"_num": {"xH": null}}, "y": {"_num": {"xO": {"xH": null}}}},
      "expected_output": {"values": [{"_num": {"xH": null}}, {"_num": {"xO": {"xH": null}}}]},
      "expected_stall": true
    },
    {
      "id": "zero_values",
      "description": "Zero as a StructuralNumbers numeral",
      "projection": {
        "pattern": {"int_zero": {"var": "i"}, "float_zero": {"var": "f"}},
        "body": {"zeros": [{"var": "i"}, {"var": "f"}]}
      },
      "input": {"int_zero": {"_num": null}, "float_zero": {"_num": null}},
      "expected_output": {"zeros": [{"_num": null}, {"_num": null}]},
      "expected_stall": true
    },
    {
      "id": "large_integer",
      "description": "Nested StructuralNumbers numeral",
      "projection": {
        "pattern": {"big": {"var": "n"}},
        "body": {"echo": {"var": "n"}}
      },
      "input": {"big": {"_num": {"xI": {"xH": null}}}},
      "expected_output": {"echo": {"_num": {"xI": {"xH": null}}}},
      "expected_stall": true
    },
    {
      "id": "variable_name_as_data",
      "description": "Input containing {var: x} should be treated as data, not pattern variable",
      "projection": {
        "pattern": {"data": {"var": "x"}},
        "body": {"matched": {"var": "x"}}
      },
      "input": {"data": {"var": "literal_string"}},
      "expected_output": {"matched": {"var": "literal_string"}},
      "expected_stall": true
    },
    {
      "id": "deep_nesting_5_levels",
      "description": "Deeply nested structure (5 levels) to test depth handling",
      "projection": {
        "pattern": {"l1": {"var": "x"}},
        "body": {"result": {"var": "x"}}
      },
      "input": {"l1": {"l2": {"l3": {"l4": {"l5": "bottom"}}}}},
      "expected_output": {"result": {"l2": {"l3": {"l4": {"l5": "bottom"}}}}},
      "expected_stall": true
    },
    {
      "id": "dict_with_head_tail_keys",
      "description": "Dict with 'head' and 'tail' keys plus extra - should NOT be treated as linked list",
      "projection": {
        "pattern": {"container": {"var": "c"}},
        "body": {"data": {"var": "c"}}
      },
      "input": {"container": {"head": "first", "tail": "second", "extra": "third"}},
      "expected_output": {"data": {"head": "first", "tail": "second", "extra": "third"}},
      "expected_stall": true
    },
    {
      "id": "unicode_key_sorting",
      "description": "Dict with unicode keys - must sort by codepoint consistently",
      "projection": {
        "pattern": {"var": "d"},
        "body": {"echo": {"var": "d"}}
      },
      "input": {"zzz": {"_num": {"xH": null}}, "aaa": {"_num": {"xO": {"xH": null}}}, "中文": {"_num": {"xI": {"xH": null}}}},
      "expected_output": {"echo": {"zzz": {"_num": {"xH": null}}, "aaa": {"_num": {"xO": {"xH": null}}}, "中文": {"_num": {"xI": {"xH": null}}}}},
      "expected_stall": true
    },
    {
      "id": "nested_empty_containers",
      "description": "Nested empty containers preserve type through normalization",
      "projection": {
        "pattern": {"data": {"var": "x"}},
        "body": {"result": {"var": "x"}}
      },
      "input": {"data": {"empty_list": [], "empty_dict": {}, "nested": [[]]}},
      "expected_output": {"result": {"empty_list": [], "empty_dict": {}, "nested": [[]]}},
      "expected_stall": true
    }
  ],
  "security_vectors": [
    {
      "id": "reject_kernel_reserved_step",
      "description": "Domain data with _step field must be rejected",
      "input": {"op": "test", "_step": "forged"},
      "expect_error": true,
      "error_contains": "_step"
    },
    {
      "id": "reject_kernel_reserved_mode",
      "description": "Domain data with _mode field must be rejected",
      "input": {"_mode": "kernel"},
      "expect_error": true,
      "error_contains": "_mode"
    },
    {
      "id": "reject_nested_reserved",
      "description": "Nested kernel-reserved field must be rejected",
      "input": {"outer": {"inner": {"_projs": []}}},
      "expect_error": true,
      "error_contains": "_projs"
    }
  ]
}
