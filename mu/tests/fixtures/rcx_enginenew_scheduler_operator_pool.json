{
  "vectors": [
    {
      "id": "select_lexicographic_head",
      "description": "Two Godel-coded unary-map operators in strict lexicographic order select 0001",
      "input": {
        "schedule_engine": {
          "seedOps": {
            "head": {
              "operator_id": "op.alpha",
              "godel_unary_map": {
                "code": "0001",
                "domain": "engine_state",
                "codomain": "engine_state",
                "identity_map": false
              }
            },
            "tail": {
              "head": {
                "operator_id": "op.beta",
                "godel_unary_map": {
                  "code": "0010",
                  "domain": "engine_state",
                  "codomain": "engine_state",
                  "identity_map": false
                }
              },
              "tail": null
            }
          },
          "frozen": null,
          "scheduler_state": {
            "phase": "ready"
          }
        }
      },
      "expected_action": "run_operator",
      "expected_operator_id": "op.alpha",
      "expected_godel_code": "0001"
    },
