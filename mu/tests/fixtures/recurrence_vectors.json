  "vectors": [
    {
      "id": "engine.closure_immediate_repeat",
      "description": "Immediate repeat (A->A stall) - closure on second occurrence",
      "input": {
        "_detect_closure": {
          "trace": {
            "head": {"step": {"_num": null}, "state": "A", "projection": null},
            "tail": {
              "head": {"step": {"_num": {"xH": null}}, "state": "A", "projection": null, "stall": true},
              "tail": null
            }
          },
          "result": "A"
        }
      },
      "expected": {
        "closure_detected": true,
        "tau_step": {"_num": {"xH": null}},
        "final_result": "A"
      },
      "notes": "State A appears twice -> closure detected at step 1"
    },
    {
      "id": "engine.no_closure_single",
      "description": "Single state in trace - no closure possible",
      "input": {
        "_detect_closure": {
          "trace": {
            "head": {"step": {"_num": null}, "state": "X", "projection": null, "stall": true},
            "tail": null
          },
          "result": "X"
        }
      },
      "expected": {
        "closure_detected": false,
        "tau_step": null,
        "final_result": "X"
      },
      "notes": "Only one state, no repetition possible"
    },
    {
      "id": "engine.closure_oscillation",
      "description": "A->B->A oscillation - closure on third entry",
      "input": {
        "_detect_closure": {
          "trace": {
            "head": {"step": {"_num": null}, "state": "A", "projection": "to_b"},
            "tail": {
              "head": {"step": {"_num": {"xH": null}}, "state": "B", "projection": "to_a"},
              "tail": {
                "head": {"step": {"_num": {"xO": {"xH": null}}}, "state": "A", "projection": "to_b"},
                "tail": null
              }
            }
          },
          "result": "A"
        }
      },
      "expected": {
        "closure_detected": true,
        "tau_step": {"_num": {"xO": {"xH": null}}},
        "final_result": "A"
      },
      "notes": "A appears at step 0 and step 2 -> closure at step 2"
    },
    {
      "id": "engine.no_closure_distinct",
      "description": "All distinct states - no closure",
      "input": {
        "_detect_closure": {
          "trace": {
            "head": {"step": {"_num": null}, "state": "S1", "projection": "inc"},
            "tail": {
              "head": {"step": {"_num": {"xH": null}}, "state": "S2", "projection": "inc"},
              "tail": {
                "head": {"step": {"_num": {"xO": {"xH": null}}}, "state": "S3", "projection": null, "stall": true},
                "tail": null
              }
            }
          },
          "result": "S3"
        }
      },
      "expected": {
        "closure_detected": false,
        "tau_step": null,
        "final_result": "S3"
      },
      "notes": "States S1, S2, S3 are all distinct"
    },
    {
      "id": "engine.closure_numeric",
      "description": "StructuralNumbers oscillation 0->1->0",
      "input": {
        "_detect_closure": {
          "trace": {
            "head": {"step": {"_num": null}, "state": {"_num": null}, "projection": "to_1"},
            "tail": {
              "head": {"step": {"_num": {"xH": null}}, "state": {"_num": {"xH": null}}, "projection": "to_0"},
              "tail": {
                "head": {"step": {"_num": {"xO": {"xH": null}}}, "state": {"_num": null}, "projection": "to_1"},
                "tail": null
              }
            }
          },
          "result": {"_num": null}
        }
      },
      "expected": {
        "closure_detected": true,
        "tau_step": {"_num": {"xO": {"xH": null}}},
        "final_result": {"_num": null}
