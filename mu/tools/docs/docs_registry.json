{
  "version": 1,
  "root_canonical_files": [
    "STATUS.md",
    "TASKS.md",
    "ROADMAP.md",
    "AGENTS.md",
    "README.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "FOUNDER_SESSION_BOOTSTRAP.md"
  ],
  "special_folders": [
    "roadmap"
  ],
  "governed_folders": [
    "mu/docs/core",
    "mu/docs/agents",
    "mu/docs/audit",
    "mu/docs/execution",
    "mu/docs/cli",
    "mu/docs/schemas",
    "mu/tools/agents",
    "mu/host/python/rcx_pi"
  ],
  "docs_registered_subfolders": [
    "core",
    "agents",
    "audit",
    "execution",
    "cli",
    "schemas"
  ],
  "exempt_patterns": [
    "^\\.pytest_cache/",
    "/\\.pytest_cache/",
    "^\\.github/",
    "^\\.rcx_library/",
    "/archive/",
    "mu/tools/agents/.*_prompt\\.md$",
    "^\\.claude/agents/",
    "^\\.claude/commands/",
    "^\\.claude/skills/",
    "\\.auto\\.md$",
    "^archive/",
    "^rcx_pi/specs/",
    "^mu/tests/archive/",
    "^mu/tests/golden/",
    "^reports/",
    "^AGENT_BRIDGE\\.md$",
    "^mu/mu_programs/",
    "^\\.agent_bus(-[A-Za-z0-9][A-Za-z0-9_-]*)?/",
    "^\\.scratch/",
    "^\\.claude/rules/",
    "^\\.claude/agent-memory/"
  ]
}
