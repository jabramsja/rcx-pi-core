{
  "version": 1,
  "root_canonical_files": [
    "STATUS.md",
    "TASKS.md",
    "README.md",
    "CLAUDE.md",
    "CHANGELOG.md"
  ],
  "special_folders": [
    "mu/docs/roadmap"
  ],
  "governed_folders": [
    "mu/docs/core",
    "mu/docs/agents",
    "mu/docs/audit",
    "mu/docs/execution",
    "mu/docs/cli",
    "mu/docs/schemas",
    "mu/docs/reviews",
    "mu/tools/agents",
    "mu/host/python/rcx_pi"
