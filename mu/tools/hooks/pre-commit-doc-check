#!/usr/bin/env bash
# Git pre-commit hook for doc consistency
# Install: ln -sf ../../tools/pre-commit-doc-check .git/hooks/pre-commit
#
# This hook:
# 1. Runs check_docs_consistency.sh (validates STATUS.md matches reality) - BLOCKS on failure
# 2. Checks debt ceiling is not exceeded - BLOCKS on failure
# 3. Runs targeted staged-file checks (py_compile, bare except, AST police, seed police)
# 4. Enforces tracker sync for core changes (`mu/` or `rcx_pi/selfhost/`) - BLOCKS on failure
# 5. [reserved]
# 6. Agent review reminder (non-blocking, cooldown-based)
# 7. Adversary review reminder (non-blocking, cooldown-based)
#
# Sections 6+7 never block or prompt. They print a one-line reminder if no
# recent agent/adversary run detected (30-min cooldown). Run agents manually
# when you choose to. Env vars to suppress: RCX_SKIP_AGENT_CHECK=1,
# RCX_SKIP_ADVERSARY_CHECK=1.
#
# Use --no-verify to skip entirely (not recommended).

set -e

cd "$(git rev-parse --show-toplevel)"

FAILED=0

# === 1. Run doc consistency validation (BLOCKING) ===
if [ -f "./tools/checks/check_docs_consistency.sh" ]; then
    echo "Running doc consistency check..."
    if ! ./tools/checks/check_docs_consistency.sh 2>/dev/null; then
        echo ""
        echo "❌ Doc consistency check FAILED"
        echo "   Run ./tools/checks/check_docs_consistency.sh to see details"
        echo "   Fix inconsistencies before committing"
        echo ""
        FAILED=1
    fi
fi

# === 2. Check debt ceiling (BLOCKING) ===
if [ -f "./tools/debt_dashboard.sh" ]; then
    DEBT_JSON=$(./tools/debt_dashboard.sh --json 2>/dev/null || echo '{}')
    CURRENT=$(echo "$DEBT_JSON" | grep -o '"total_semantic": [0-9]*' | grep -o '[0-9]*' || echo "0")
    THRESHOLD=$(grep -E '^THRESHOLD:' STATUS.md 2>/dev/null | grep -o '[0-9]*' || echo "999")

    if [ "$CURRENT" -gt "$THRESHOLD" ]; then
        echo ""
        echo "❌ DEBT CEILING EXCEEDED: $CURRENT > $THRESHOLD"
        echo "   Run ./tools/debt_dashboard.sh to see debt locations"
        echo "   Fix debt or update threshold in STATUS.md before committing"
        echo ""
        FAILED=1
    fi
fi

# === 3. Get staged files ===
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
STAGED_RCX_PY=$(echo "$STAGED_PY" | grep -E '^(rcx_pi/|mu/host/python/rcx_pi/)' || true)
STAGED_SEEDS=$(echo "$STAGED_FILES" | grep -E '^mu/.*\.json$' || true)

DOCS_CHANGED=$(echo "$STAGED_FILES" | grep -E '^(mu/docs/|roadmap/|mu/tools/agents/|README\.md|STATUS\.md|TASKS\.md|ROADMAP\.md|CLAUDE\.md|CHANGELOG\.md)' || true)

# === 3b. Run doc tests if docs changed (BLOCKING, ~2s) ===
if [ -n "$DOCS_CHANGED" ]; then
    echo "Running doc governance tests (docs changed)..."
    if ! PYTHONHASHSEED=0 python3 -m pytest tests/docs -q 2>/dev/null; then
        echo ""
        echo "❌ Doc governance tests FAILED"
        echo "   Run: PYTHONHASHSEED=0 pytest tests/docs -v"
        echo ""
        FAILED=1
    fi
fi

# === 4. Targeted staged-file checks (BLOCKING) ===
if [ -n "$STAGED_PY" ]; then
    echo "Running staged Python syntax check..."
    for f in $STAGED_PY; do
        if [ -f "$f" ] && ! python3 -m py_compile "$f" 2>/dev/null; then
            echo ""
            echo "❌ Python syntax check failed: $f"
            FAILED=1
        fi
    done
fi

if [ -n "$STAGED_RCX_PY" ]; then
    echo "Checking for bare except clauses in staged rcx_pi files..."
    for f in $STAGED_RCX_PY; do
        if grep -nE '^[[:space:]]*except[[:space:]]*:' "$f" 2>/dev/null; then
            echo ""
            echo "❌ Bare except clause found in $f"
            FAILED=1
        fi
    done

    echo "Running AST police on staged rcx_pi files..."
    if ! python3 tools/checks/linters/ast_police.py $STAGED_RCX_PY 2>/dev/null; then
        echo ""
        echo "❌ AST police check failed for staged rcx_pi files"
        FAILED=1
    fi
fi

if [ -n "$STAGED_SEEDS" ]; then
    echo "Running seed police (staged mu/*.json detected)..."
    if ! ./tools/checks/linters/seed_police.sh 2>/dev/null; then
        echo ""
        echo "❌ Seed police check failed"
        FAILED=1
    fi
fi

# === 4b. Speed enforcer for staged test files (BLOCKING) ===
# Delegates to tools/check_test_speed.sh (single source of truth for slow-function list)
STAGED_TESTS=$(echo "$STAGED_PY" | grep '^mu/tests/' || true)
if [ -n "$STAGED_TESTS" ]; then
    echo "Running speed enforcer on staged test files..."
    for f in $STAGED_TESTS; do
        if [ -f "$f" ]; then
            if ! bash tools/checks/check_test_speed.sh "$f" 2>/dev/null | grep -q "No speed violations"; then
                bash tools/checks/check_test_speed.sh "$f"
                FAILED=1
            fi
        fi
    done
fi

# === 5. Enforce tracker sync for core changes (BLOCKING) ===
if [ -f "./tools/checks/enforce_tracker_sync.sh" ]; then
    if ! ./tools/checks/enforce_tracker_sync.sh --staged; then
        FAILED=1
    fi
fi

# === 5b. Check for untracked backup/temp artifacts (WARNING, non-blocking) ===
if [ -f "./tools/checks/check_untracked_artifacts.sh" ]; then
    if ! ./tools/checks/check_untracked_artifacts.sh --quiet 2>/dev/null; then
        echo ""
        echo "⚠️  Untracked backup/temp artifacts detected in mu/ subtrees"
        echo "   Run: ./tools/checks/check_untracked_artifacts.sh"
        echo "   (Non-blocking — clean up when convenient)"
        echo ""
    fi
fi

# === 6. Agent review reminder (non-blocking, cooldown-based) ===
# Prints a one-line reminder if no recent agent review. Never blocks or prompts.
# RCX_SKIP_AGENT_CHECK=1 suppresses the reminder entirely.
CORE_FILES_CHANGED=$(echo "$STAGED_FILES" | grep -E '^(rcx_pi/selfhost/|mu/host/python/rcx_pi/selfhost/|mu/)' | grep -v '^mu/docs/' | grep -v '^mu/tools/' | grep -v '^mu/scripts/' | grep -v '^mu/tests/' || true)
if [ -n "$CORE_FILES_CHANGED" ] && [ "${RCX_SKIP_AGENT_CHECK:-}" != "1" ]; then
    MEMORY_FILE=".agent_memory/findings.json"
    AGENT_RUN_RECENT=false

    if [ -f "$MEMORY_FILE" ]; then
        if [ "$(uname)" = "Darwin" ]; then
            MEMORY_AGE=$(( $(date +%s) - $(stat -f %m "$MEMORY_FILE") ))
        else
            MEMORY_AGE=$(( $(date +%s) - $(stat -c %Y "$MEMORY_FILE") ))
        fi
        if [ "$MEMORY_AGE" -lt 1800 ]; then
            AGENT_RUN_RECENT=true
        fi
    fi

    if [ "$AGENT_RUN_RECENT" = "false" ]; then
        CORE_FILE_LIST=$(echo "$CORE_FILES_CHANGED" | tr '\n' ' ')
        echo "   ℹ️  No recent agent review. Run when ready: python tools/runners/run_review.py $CORE_FILE_LIST --depth quick"
    fi
fi

# === 7. Adversary review reminder (non-blocking, cooldown-based) ===
# Prints a one-line reminder if no recent adversary run. Never blocks or prompts.
# RCX_SKIP_ADVERSARY_CHECK=1 suppresses the reminder entirely.
if [ -n "$CORE_FILES_CHANGED" ] && [ "${RCX_SKIP_ADVERSARY_CHECK:-}" != "1" ]; then
    ADVERSARY_COOLDOWN="/tmp/.rcx_adversary_cooldown"
    ADVERSARY_RUN_RECENT=false

    if [ -f "$ADVERSARY_COOLDOWN" ]; then
        if [ "$(uname)" = "Darwin" ]; then
            COOLDOWN_AGE=$(( $(date +%s) - $(stat -f %m "$ADVERSARY_COOLDOWN") ))
        else
            COOLDOWN_AGE=$(( $(date +%s) - $(stat -c %Y "$ADVERSARY_COOLDOWN") ))
        fi
        if [ "$COOLDOWN_AGE" -lt 1800 ]; then
            ADVERSARY_RUN_RECENT=true
        fi
    fi

    if [ "$ADVERSARY_RUN_RECENT" = "false" ]; then
        CORE_FILE_LIST=$(echo "$CORE_FILES_CHANGED" | tr '\n' ' ')
        echo "   ℹ️  No recent adversary review. Run when ready: python tools/runners/run_adversary.py $CORE_FILE_LIST --model sonnet"
    fi
fi

# Exit with failure if any blocking check failed
if [ "$FAILED" -eq 1 ]; then
    echo "Pre-commit checks failed. Use --no-verify to bypass (not recommended)."
    exit 1
fi

exit 0
