#!/bin/bash
# Pre-push hook: enforces tracker sync + runs fast audit before pushing
# Quick sanity check (~2-3 min) - CI runs full validation after push
# For comprehensive local validation, run: ./tools/audit_all.sh
#
# Install: ln -sf ../../tools/pre-push-fast .git/hooks/pre-push

echo "Running pre-push check (dev.sh → audit_fast.sh)..."
echo ""

# Get repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Enforce tracker sync for commits being pushed
RANGE=""
if git rev-parse --verify --quiet @{upstream} >/dev/null; then
    RANGE="@{upstream}...HEAD"
elif git show-ref --verify --quiet refs/remotes/origin/dev; then
    RANGE="origin/dev...HEAD"
fi

if [ -n "$RANGE" ]; then
    # Check if range has any changed files (nothing to push = nothing to enforce)
    RANGE_FILES="$(git diff --name-only "$RANGE" 2>/dev/null || true)"
    if [ -z "$RANGE_FILES" ]; then
        echo "No committed changes in range $RANGE — skipping tracker sync and L4 checks"
    else
        if ! "$REPO_ROOT/tools/checks/enforce_tracker_sync.sh" --range "$RANGE"; then
            echo ""
            echo "❌ Pre-push tracker sync check failed."
            echo "   Add STATUS.md or TASKS.md updates for core structural changes."
            exit 1
        fi
        # Check for stale NEXT items (merged PRs not marked Landed)
        if [ -f "$REPO_ROOT/tools/checks/check_stale_next_items.sh" ]; then
            if ! bash "$REPO_ROOT/tools/checks/check_stale_next_items.sh"; then
                echo ""
                echo "⚠️  Stale NEXT items detected — merged PRs not marked Landed."
                echo "   Update TASKS.md NEXT section before pushing."
                echo "   Run: bash tools/checks/check_stale_next_items.sh --fix"
                exit 1
            fi
        fi
        # L4 contract must evaluate the FULL wave diff from dev, not
        # per-push incremental.  Incremental ranges miss runtime files
        # committed in earlier pushes, causing indicator delta mismatches
        # with CI (which always uses origin/dev...HEAD).
        L4_RANGE="origin/dev...HEAD"
        L4_RANGE_FILES="$(git diff --name-only "$L4_RANGE" 2>/dev/null || true)"
        # Derive wave-id from branch name when the full wave diff includes
        # TASKS.md.  Supports codex/* and jabramsja/* naming conventions.
        # This avoids forcing structural-wave validation on follow-up
        # CI/tooling commits that don't carry tracker-note updates.
        BRANCH="$(git rev-parse --abbrev-ref HEAD)"
        WAVE_ID_FLAG=""
        WAVE_ID_SUFFIX=""
        if [[ "$BRANCH" == codex/* ]]; then
            WAVE_ID_SUFFIX="${BRANCH#codex/}"
        elif [[ "$BRANCH" == jabramsja/* ]]; then
            WAVE_ID_SUFFIX="${BRANCH#jabramsja/}"
        fi
        if [ -n "$WAVE_ID_SUFFIX" ] && echo "$L4_RANGE_FILES" | grep -qx "TASKS.md"; then
            # Check if the branch-derived wave_id actually exists in a tracker note.
            # Format in TASKS.md: "Tracker sync note (YYYY-MM-DD, wave-id):"
            if grep -q ", ${WAVE_ID_SUFFIX}):" TASKS.md 2>/dev/null; then
                WAVE_ID_FLAG="--wave-id $WAVE_ID_SUFFIX"
            else
                # Branch name doesn't match a tracker note wave_id.
                # Extract available wave_ids from TASKS.md (macOS-compatible).
                AVAILABLE_IDS=$(sed -n 's/.*Tracker sync note ([0-9-]*, \([A-Za-z0-9_-]*\)).*/\1/p' TASKS.md 2>/dev/null | head -20)
                for AID in $AVAILABLE_IDS; do
                    # Use the first tracker note that the L4 checker accepts
                    if python3 "$REPO_ROOT/tools/checks/enforce_l4_execution_contract.py" --range "$L4_RANGE" --wave-id "$AID" >/dev/null 2>&1; then
                        WAVE_ID_FLAG="--wave-id $AID"
                        break
                    fi
                done
            fi
        fi
        if ! python3 "$REPO_ROOT/tools/checks/enforce_l4_execution_contract.py" --range "$L4_RANGE" $WAVE_ID_FLAG; then
            echo ""
            echo "❌ L4 execution contract check failed."
            echo "   See roadmap/L4ExecutionContract.v2.md for wave classification rules."
            exit 1
        fi
    fi
fi

# Check for untracked backup/temp artifacts (BLOCKING)
if [ -f "$REPO_ROOT/tools/checks/check_untracked_artifacts.sh" ]; then
    if ! "$REPO_ROOT/tools/checks/check_untracked_artifacts.sh"; then
        echo ""
        echo "❌ Untracked backup/temp artifacts in mu/ subtrees."
        echo "   Clean up before pushing, or add to .untracked_artifact_allowlist."
        exit 1
    fi
fi

# Run fast audit (not --full, which is redundant with CI)
if ! "$REPO_ROOT/dev.sh"; then
    echo ""
    echo "❌ Pre-push check failed. Fix issues before pushing."
    echo "   To bypass (not recommended): git push --no-verify"
    exit 1
fi

echo ""
echo "✅ Pre-push check passed"
echo "   Note: CI will run full validation. For local full audit: ./tools/audit_all.sh"
