{
  "meta": {
    "version": "1.0.0",
    "name": "EXHAUST_SEED",
    "description": "Structural operator exhaustion detection for Rule 3.1",
    "doc": "docs/core/OperatorExhaustion.v0.md",
    "spec_ref": "RCXEngineNew.pdf Rule 3.1",
    "execution_layer": "BOOTSTRAP",
    "requires_patterns": ["non-linear"],
    "incompatible_with": ["match.v2 (linear only)"],
    "meta_circular_blocker": "Requires match.v3 with binding conflict detection",
    "invariants": [
      "All projections are pure Mu (JSON-compatible)",
      "Exhaustion detection uses pattern matching, NOT Python conditionals",
      "Frozen set is a Mu linked-list, NOT Python set",
      "Non-linear patterns (same var twice) detect operator equality",
      "First-match-wins ordering handles inequality cases"
    ],
    "bootstrap_dependencies": [
      "eval_step() binding conflict detection (non-linear pattern enforcement)",
      "Both Python and JS substrates handle non-linear patterns identically"
    ]
  },
  "projections": [
    {
      "id": "exhaust.init_null",
      "description": "No tau_step (null) means no closure detected, so no exhaustion possible",
      "pattern": {
        "_detect_exhaustion": {
          "trace": {"var": "trace"},
          "frozen": {"var": "frozen"},
          "tau_step": null,
          "operator_ids": {"var": "op_ids"}
        }
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "continue"
      }
    },
    {
      "id": "exhaust.init",
      "description": "tau_step is set, begin finding the tau entry in trace",
      "pattern": {
        "_detect_exhaustion": {
          "trace": {"var": "trace"},
          "frozen": {"var": "frozen"},
          "tau_step": {"var": "tau_step"},
          "operator_ids": {"var": "op_ids"}
        }
      },
      "body": {
        "_mode": "exhaust",
        "_phase": "find_tau",
        "_trace": {"var": "trace"},
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": null,
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaust.find_match",
      "description": "Found entry where step == tau_step (non-linear pattern), extract operator",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "find_tau",
        "_trace": {
          "head": {
            "step": {"var": "step"},
            "state": {"var": "_state"},
            "projection": {"var": "proj"}
          },
          "tail": {"var": "rest"}
        },
        "_tau_step": {"var": "step"},
        "_tau_operator": {"var": "_"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaust",
        "_phase": "scan",
        "_trace": {"var": "rest"},
        "_tau_step": {"var": "step"},
        "_tau_operator": {"var": "proj"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaust.find_continue",
      "description": "Not at tau_step yet, advance to next trace entry",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "find_tau",
        "_trace": {
          "head": {"var": "_head"},
          "tail": {"var": "rest"}
        },
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaust",
        "_phase": "find_tau",
        "_trace": {"var": "rest"},
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaust.find_not_found",
      "description": "Reached end of trace without finding tau_step (edge case)",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "find_tau",
        "_trace": null,
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "_"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "continue"
      }
    },
    {
      "id": "exhaust.scan_same",
      "description": "Current entry has same operator as tau (non-linear), continue scanning",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "scan",
        "_trace": {
          "head": {
            "step": {"var": "_step"},
            "state": {"var": "_state"},
            "projection": {"var": "proj"}
          },
          "tail": {"var": "rest"}
        },
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "proj"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaust",
        "_phase": "scan",
        "_trace": {"var": "rest"},
        "_tau_step": {"var": "tau_step"},
        "_tau_operator": {"var": "proj"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaust.scan_different",
      "description": "Different operator found (scan_same didn't match), not exhausted",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "scan",
        "_trace": {
          "head": {"var": "_head"},
          "tail": {"var": "_rest"}
        },
        "_tau_step": {"var": "_tau_step"},
        "_tau_operator": {"var": "_tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "_op_ids"}
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "continue"
      }
    },
    {
      "id": "exhaust.scan_end",
      "description": "End of trace reached, same operator throughout -> check if frozen",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "scan",
        "_trace": null,
        "_tau_step": {"var": "_tau_step"},
        "_tau_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaust",
        "_phase": "check_frozen",
        "_operator": {"var": "tau_op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {"var": "frozen"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaust.frozen_found",
      "description": "Operator already in frozen list (non-linear match), skip",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {
          "head": {"var": "op"},
          "tail": {"var": "_"}
        },
        "_operator_ids": {"var": "_op_ids"}
      },
      "body": {
        "exhaustion_detected": false,
        "operator_to_freeze": null,
        "frozen": {"var": "frozen"},
        "action": "already_frozen"
      }
    },
    {
      "id": "exhaust.frozen_check_tail",
      "description": "Operator not in head of frozen list, check tail",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {
          "head": {"var": "_other"},
          "tail": {"var": "rest"}
        },
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "_mode": "exhaust",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": {"var": "rest"},
        "_operator_ids": {"var": "op_ids"}
      }
    },
    {
      "id": "exhaust.do_freeze",
      "description": "Operator not in frozen list (null), freeze it",
      "pattern": {
        "_mode": "exhaust",
        "_phase": "check_frozen",
        "_operator": {"var": "op"},
        "_frozen": {"var": "frozen"},
        "_frozen_check": null,
        "_operator_ids": {"var": "op_ids"}
      },
      "body": {
        "exhaustion_detected": true,
        "operator_to_freeze": {"var": "op"},
        "frozen": {
          "head": {"var": "op"},
          "tail": {"var": "frozen"}
        },
        "action": "freeze"
      }
    }
  ]
}
