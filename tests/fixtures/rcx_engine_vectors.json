{
  "meta": {
    "description": "Test vectors for rcx_engine.v1.json projections (boundary_request protocol)",
    "created": "2026-02-03",
    "updated": "2026-02-10",
    "seed": "rcx_engine.v1.json"
  },
  "vectors": [
    {
      "id": "engine.init_default",
      "description": "Initialize engine with default config — emits run_trace boundary request",
      "input": {
        "_run_engine": {
          "projections": [{"id": "test.proj", "pattern": {}, "body": {}}],
          "input": {"value": 42}
        }
      },
      "expected": {
        "_boundary_request": {
          "operation": "run_trace",
          "input": {
            "projections": [{"id": "test.proj", "pattern": {}, "body": {}}],
            "value": {"value": 42},
            "max_steps": 100
          },
          "context": {
            "_mode": "engine",
            "_frozen": null
          },
          "inject_key": "_trace_result"
        }
      }
    },
    {
      "id": "engine.init_custom",
      "description": "Initialize engine with custom config — emits run_trace boundary request",
      "input": {
        "_run_engine": {
          "projections": [{"id": "test.proj", "pattern": {}, "body": {}}],
          "input": {"value": 42},
          "max_steps": 50,
          "frozen": {"head": "op1", "tail": null}
        }
      },
      "expected": {
        "_boundary_request": {
          "operation": "run_trace",
          "input": {
            "projections": [{"id": "test.proj", "pattern": {}, "body": {}}],
            "value": {"value": 42},
            "max_steps": 50
          },
          "context": {
            "_mode": "engine",
            "_frozen": {"head": "op1", "tail": null}
          },
          "inject_key": "_trace_result"
        }
      }
    },
    {
      "id": "engine.trace_done",
      "description": "Trace complete — emits hash_trace boundary request",
      "input": {
        "_mode": "engine",
        "_frozen": null,
        "_trace_result": {
          "result": {"final": "value"},
          "trace": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null},
          "stall": false
        }
      },
      "expected": {
        "_boundary_request": {
          "operation": "hash_trace",
          "input": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null},
          "context": {
            "_mode": "engine",
            "_result": {"final": "value"},
            "_frozen": null,
            "_stall": false,
            "_raw_trace": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null}
          },
          "inject_key": "_hashed_trace"
        }
      }
    },
    {
      "id": "engine.hash_done",
      "description": "Trace hashed — emits run_algorithm boundary request for recurrence",
      "input": {
        "_mode": "engine",
        "_result": {"final": "value"},
        "_frozen": null,
        "_stall": false,
        "_raw_trace": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null},
        "_hashed_trace": {"head": {"step": 0, "state": "A", "state_hash": "abc123", "projection": "p1"}, "tail": null}
      },
      "expected": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "recurrence.v2.json",
          "input": {
            "_detect_closure": {
              "trace": {"head": {"step": 0, "state": "A", "state_hash": "abc123", "projection": "p1"}, "tail": null},
              "result": {"final": "value"}
            }
          },
          "context": {
            "_mode": "engine",
            "_frozen": null,
            "_stall": false,
            "_raw_trace": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null}
          },
          "inject_key": "_recurrence_result"
        }
      }
    },
    {
      "id": "engine.recurrence_done_to_exhaustion",
      "description": "Recurrence complete — emits run_algorithm boundary request for exhaustion",
      "input": {
        "_mode": "engine",
        "_frozen": null,
        "_stall": false,
        "_raw_trace": {"head": {"step": 0, "state": "A", "projection": "op1"}, "tail": null},
        "_recurrence_result": {
          "closure_detected": true,
          "tau_step": 5,
          "final_result": {"computed": "result"}
        }
      },
      "expected": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "exhaustion.v1.json",
          "input": {
            "_detect_exhaustion": {
              "trace": {"head": {"step": 0, "state": "A", "projection": "op1"}, "tail": null},
              "frozen": null,
              "tau_step": 5,
              "operator_ids": null
            }
          },
          "context": {
            "_mode": "engine",
            "_stall": false,
            "_closure_detected": true,
            "_tau_step": 5,
            "_final_result": {"computed": "result"}
          },
          "inject_key": "_exhaustion_result"
        }
      }
    },
    {
      "id": "engine.exhaustion_done",
      "description": "Exhaustion complete — produces final engine result (no boundary request)",
      "input": {
        "_mode": "engine",
        "_stall": false,
        "_closure_detected": true,
        "_tau_step": 5,
        "_final_result": {"computed": "result"},
        "_exhaustion_result": {
          "exhaustion_detected": true,
          "operator_to_freeze": "op1",
          "frozen": {"head": "op1", "tail": null},
          "action": "freeze"
        }
      },
      "expected": {
        "engine_result": {
          "value": {"computed": "result"},
          "closure_detected": true,
          "tau_step": 5,
          "exhaustion_detected": true,
          "operator_frozen": "op1",
          "frozen_set": {"head": "op1", "tail": null},
          "action": "freeze",
          "stall": false
        }
      }
    },
    {
      "id": "engine.unwrap",
      "description": "Unwrap extracts final engine result",
      "input": {
        "engine_result": {
          "value": {"computed": "result"},
          "closure_detected": true,
          "tau_step": 5,
          "exhaustion_detected": true,
          "operator_frozen": "op1",
          "frozen_set": {"head": "op1", "tail": null},
          "action": "freeze",
          "stall": false
        }
      },
      "expected": {
        "value": {"computed": "result"},
        "closure_detected": true,
        "tau_step": 5,
        "exhaustion_detected": true,
        "operator_frozen": "op1",
        "frozen_set": {"head": "op1", "tail": null},
        "action": "freeze",
        "stall": false
      }
    },
    {
      "id": "engine.no_closure",
      "description": "No closure detected — still emits exhaustion boundary request",
      "input": {
        "_mode": "engine",
        "_frozen": null,
        "_stall": true,
        "_raw_trace": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null},
        "_recurrence_result": {
          "closure_detected": false,
          "tau_step": null,
          "final_result": {"computed": "result"}
        }
      },
      "expected": {
        "_boundary_request": {
          "operation": "run_algorithm",
          "algorithm": "exhaustion.v1.json",
          "input": {
            "_detect_exhaustion": {
              "trace": {"head": {"step": 0, "state": "A", "projection": "p1"}, "tail": null},
              "frozen": null,
              "tau_step": null,
              "operator_ids": null
            }
          },
          "context": {
            "_mode": "engine",
            "_stall": true,
            "_closure_detected": false,
            "_tau_step": null,
            "_final_result": {"computed": "result"}
          },
          "inject_key": "_exhaustion_result"
        }
      }
    }
  ]
}
