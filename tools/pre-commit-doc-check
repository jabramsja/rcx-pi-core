#!/usr/bin/env bash
# Git pre-commit hook for doc consistency
# Install: ln -sf ../../tools/pre-commit-doc-check .git/hooks/pre-commit
#
# This hook:
# 1. Runs check_docs_consistency.sh (validates STATUS.md matches reality) - BLOCKS on failure
# 2. Checks debt ceiling is not exceeded - BLOCKS on failure
# 3. Runs targeted staged-file checks (py_compile, bare except, AST police, seed police)
# 4. Enforces tracker sync for core changes (`mu/` or `rcx_pi/selfhost/`) - BLOCKS on failure
#
# Use --no-verify to skip entirely (not recommended).

set -e

cd "$(git rev-parse --show-toplevel)"

FAILED=0

# === 1. Run doc consistency validation (BLOCKING) ===
if [ -f "./tools/check_docs_consistency.sh" ]; then
    echo "Running doc consistency check..."
    if ! ./tools/check_docs_consistency.sh 2>/dev/null; then
        echo ""
        echo "❌ Doc consistency check FAILED"
        echo "   Run ./tools/check_docs_consistency.sh to see details"
        echo "   Fix inconsistencies before committing"
        echo ""
        FAILED=1
    fi
fi

# === 2. Check debt ceiling (BLOCKING) ===
if [ -f "./tools/debt_dashboard.sh" ]; then
    DEBT_JSON=$(./tools/debt_dashboard.sh --json 2>/dev/null || echo '{}')
    CURRENT=$(echo "$DEBT_JSON" | grep -o '"total_semantic": [0-9]*' | grep -o '[0-9]*' || echo "0")
    THRESHOLD=$(grep -E '^THRESHOLD:' STATUS.md 2>/dev/null | grep -o '[0-9]*' || echo "999")

    if [ "$CURRENT" -gt "$THRESHOLD" ]; then
        echo ""
        echo "❌ DEBT CEILING EXCEEDED: $CURRENT > $THRESHOLD"
        echo "   Run ./tools/debt_dashboard.sh to see debt locations"
        echo "   Fix debt or update threshold in STATUS.md before committing"
        echo ""
        FAILED=1
    fi
fi

# === 3. Get staged files ===
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
STAGED_RCX_PY=$(echo "$STAGED_PY" | grep '^rcx_pi/' || true)
STAGED_SEEDS=$(echo "$STAGED_FILES" | grep -E '^mu/.*\.json$' || true)

DOCS_CHANGED=$(echo "$STAGED_FILES" | grep -E '^(mu/docs/|tools/agents/|README\.md|STATUS\.md|TASKS\.md|CLAUDE\.md|CHANGELOG\.md)' || true)

# === 3b. Run doc tests if docs changed (BLOCKING, ~2s) ===
if [ -n "$DOCS_CHANGED" ]; then
    echo "Running doc governance tests (docs changed)..."
    if ! PYTHONHASHSEED=0 python3 -m pytest tests/docs -q 2>/dev/null; then
        echo ""
        echo "❌ Doc governance tests FAILED"
        echo "   Run: PYTHONHASHSEED=0 pytest tests/docs -v"
        echo ""
        FAILED=1
    fi
fi

# === 4. Targeted staged-file checks (BLOCKING) ===
if [ -n "$STAGED_PY" ]; then
    echo "Running staged Python syntax check..."
    for f in $STAGED_PY; do
        if [ -f "$f" ] && ! python3 -m py_compile "$f" 2>/dev/null; then
            echo ""
            echo "❌ Python syntax check failed: $f"
            FAILED=1
        fi
    done
fi

if [ -n "$STAGED_RCX_PY" ]; then
    echo "Checking for bare except clauses in staged rcx_pi files..."
    for f in $STAGED_RCX_PY; do
        if grep -nE '^[[:space:]]*except[[:space:]]*:' "$f" 2>/dev/null; then
            echo ""
            echo "❌ Bare except clause found in $f"
            FAILED=1
        fi
    done

    echo "Running AST police on staged rcx_pi files..."
    if ! python3 tools/ast_police.py $STAGED_RCX_PY 2>/dev/null; then
        echo ""
        echo "❌ AST police check failed for staged rcx_pi files"
        FAILED=1
    fi
fi

if [ -n "$STAGED_SEEDS" ]; then
    echo "Running seed police (staged mu/*.json detected)..."
    if ! ./tools/seed_police.sh 2>/dev/null; then
        echo ""
        echo "❌ Seed police check failed"
        FAILED=1
    fi
fi

# === 4b. Speed enforcer for staged test files (BLOCKING) ===
# Delegates to tools/check_test_speed.sh (single source of truth for slow-function list)
STAGED_TESTS=$(echo "$STAGED_PY" | grep '^tests/' || true)
if [ -n "$STAGED_TESTS" ]; then
    echo "Running speed enforcer on staged test files..."
    for f in $STAGED_TESTS; do
        if [ -f "$f" ]; then
            if ! bash tools/check_test_speed.sh "$f" 2>/dev/null | grep -q "No speed violations"; then
                bash tools/check_test_speed.sh "$f"
                FAILED=1
            fi
        fi
    done
fi

# === 5. Enforce tracker sync for core changes (BLOCKING) ===
if [ -f "./tools/enforce_tracker_sync.sh" ]; then
    if ! ./tools/enforce_tracker_sync.sh --staged; then
        FAILED=1
    fi
fi

# === 6. Check if agents were run on staged core files (WARNING) ===
CORE_FILES_CHANGED=$(echo "$STAGED_FILES" | grep -E '^(rcx_pi/selfhost/|mu/)' || true)
if [ -n "$CORE_FILES_CHANGED" ]; then
    MEMORY_FILE=".agent_memory/findings.json"
    AGENT_RUN_RECENT=false

    if [ -f "$MEMORY_FILE" ]; then
        # Check if agent memory was updated in last 30 minutes
        if [ "$(uname)" = "Darwin" ]; then
            MEMORY_AGE=$(( $(date +%s) - $(stat -f %m "$MEMORY_FILE") ))
        else
            MEMORY_AGE=$(( $(date +%s) - $(stat -c %Y "$MEMORY_FILE") ))
        fi

        if [ "$MEMORY_AGE" -lt 1800 ]; then
            AGENT_RUN_RECENT=true
        fi
    fi

    if [ "$AGENT_RUN_RECENT" = "false" ]; then
        echo ""
        echo "⚠️  AGENT REVIEW REMINDER:"
        echo "   Core files staged: $(echo "$CORE_FILES_CHANGED" | tr '\n' ' ')"
        echo "   No recent agent review detected (.agent_memory older than 30min or missing)"
        echo ""
        echo "   Run before commit:"
        echo "     python tools/run_review.py <files> --depth full"
        echo ""
        echo "   Skip this check with --no-verify (not recommended for core changes)"
        echo ""
    fi
fi

# Exit with failure if any blocking check failed
if [ "$FAILED" -eq 1 ]; then
    echo "Pre-commit checks failed. Use --no-verify to bypass (not recommended)."
    exit 1
fi

exit 0
